{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["bun install --frozen-lockfile"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "bun run -F @repo/db prisma generate",
        "bun x turbo build --filter=web..."
      ]
    }
  },
  "deploy": {
    "startCommand": "bun run -F web start"
  }
}
