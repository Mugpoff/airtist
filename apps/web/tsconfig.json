{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    },
    "allowArbitraryExtensions": true,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "src",
    "next.config.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "node_modules/@repo/typescript-config/global.d.ts"
  ]
}
